#!/bin/bash
#PBS -N snqs_lpe_grid
#PBS -P 15004320
#PBS -q normal
#PBS -J 0-7
#PBS -l select=1:ncpus=8:mem=32GB:ngpus=1
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail

cd "$PBS_O_WORKDIR"
module purge

export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8
export PYTHONUNBUFFERED=1

eval "$(conda shell.bash hook)"
conda activate py312

nvidia-smi
python -c "import torch; print('torch', torch.__version__, 'cuda', torch.version.cuda, 'available', torch.cuda.is_available()); print('device_count', torch.cuda.device_count())"

python run_lpe_split_array.py --job-id "$PBS_ARRAY_INDEX"
